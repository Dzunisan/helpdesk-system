# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# --- Server ---
# Port the API listens on (avoid 5000 on macOS, AirPlay uses it)
SERVER_PORT=5050
# Frontend origin: allowed by CORS and used in password-reset links
CLIENT_URL=http://localhost:5173
# Set to "production" in deployed environments (makes the session cookie Secure)
NODE_ENV=development

# --- Database (Postgres) ---
# db:seed and db:reset refuse to run unless DB_HOST is localhost or 127.0.0.1
DB_HOST=localhost
# Postgres port
DB_PORT=5432
# Database name, e.g. created with: createdb helpdesk_dev
DB_DATABASE=helpdesk_dev
# Postgres user
DB_USER=postgres
# Postgres password (leave empty if your local user has none)
DB_PASSWORD=

# --- Auth ---
# Secret used to sign the session JWT; use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# --- Tickets ---
# Minutes a comment stays editable after it is posted (optional)
COMMENT_EDIT_WINDOW_MINUTES=15

# --- Email (SMTP, for password reset and ticket notifications) ---
# SMTP server host. Locally use a free Mailtrap sandbox inbox (mailtrap.io > Email Testing > SMTP),
# which catches every email so nothing reaches real people. Leave EMAIL_PASS empty to simulate email.
EMAIL_HOST=sandbox.smtp.mailtrap.io
# SMTP port (Mailtrap: 2525 or 587 with STARTTLS; 465 for SSL)
EMAIL_PORT=2525
# "true" for port 465 (SSL), "false" otherwise
EMAIL_SECURE=false
# SMTP username (from the Mailtrap inbox's SMTP credentials)
EMAIL_USER=your-mailtrap-username
# SMTP password (from the same page)
EMAIL_PASS=
# From address on every email (needed when the SMTP username isn't an email address)
EMAIL_FROM=helpdesk@mzansifreight.co.za
