# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# --- Server ---
# Port the API listens on (avoid 5000 on macOS, AirPlay uses it)
SERVER_PORT=5050
# Frontend origin: allowed by CORS and used in password-reset links
CLIENT_URL=http://localhost:5173
# Set to "production" in deployed environments (makes the session cookie Secure)
NODE_ENV=development

# --- Database (Postgres) ---
# db:seed and db:reset refuse to run unless DB_HOST is localhost or 127.0.0.1
DB_HOST=localhost
# Postgres port
DB_PORT=5432
# Database name, e.g. created with: createdb helpdesk_dev
DB_DATABASE=helpdesk_dev
# Postgres user
DB_USER=postgres
# Postgres password (leave empty if your local user has none)
DB_PASSWORD=

# --- Auth ---
# Secret used to sign the session JWT; use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# --- Tickets ---
# Minutes a comment stays editable after it is posted (optional)
COMMENT_EDIT_WINDOW_MINUTES=15

# --- Email (SMTP, for password reset and ticket notifications) ---
# SMTP server host (any free SMTP works; leave as-is locally if you don't send mail)
EMAIL_HOST=smtp.example.com
# SMTP port (587 for STARTTLS, 465 for SSL)
EMAIL_PORT=587
# "true" for port 465 (SSL), "false" otherwise
EMAIL_SECURE=false
# SMTP username, also used as the From address
EMAIL_USER=helpdesk@example.com
# SMTP password or app password
EMAIL_PASS=change-me
